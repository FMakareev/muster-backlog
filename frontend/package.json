    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@svar-ui/svelte-kanban": "2.6.0",
    "@wailsio/runtime": "3.0.0-beta.8",
    "nanostores": "1.5.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
