{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "muster",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        "build/config.yml"
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Housekeeping",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Housekeeping",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Housekeeping",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Housekeeping",
          "hidden": true
        }
      ]
    }
  }
}
